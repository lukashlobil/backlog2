{
  "name": "backlog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "tsx --env-file-if-exists=.env apps/api/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:e2e": "playwright test",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-backlog-storage --config firebase.firestore.test.json \"tsx --test tests/firestore.integration.ts\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "gaxios": { "uuid": "^11.1.1" }
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.32.1",
    "tsx": "^4.19.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
