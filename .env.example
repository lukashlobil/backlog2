# Optional. Books and manual entry work without credentials.
# https://dev.twitch.tv/console/apps (used by IGDB)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# TMDB API Read Access Token: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
# Firebase Console > Project settings > Your apps > Web app SDK configuration.
# These four values are public web configuration, NOT a service-account key.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Optional: explicitly assign the existing pre-auth backlog to this Firebase UID.
# LEGACY_BACKLOG_OWNER_UID=
# PORT=3001
# HOST=127.0.0.1
# Docker Compose host port (container port stays 3001):
# BACKLOG_HTTP_PORT=8080
# BACKLOG_DATA_FILE=data/backlog.json
# Firestore is the default. Use file only for deliberate local-only operation.
BACKLOG_STORAGE=firestore
# For npm development (Docker uses compose.firestore.yaml instead):
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-service-account.json
# Optional one-account import from existing server files; never overwrites cloud data:
# FIRESTORE_IMPORT_UID=exact_firebase_uid
